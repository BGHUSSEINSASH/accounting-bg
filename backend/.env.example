PORT=3000
JWT_SECRET=your-super-secret-key-change-this
REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Cloud sync
CLOUD_PROVIDER=none
# Supabase: set these for direct uploads to Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=accounting-files
# S3 / Backblaze B2 (S3-compatible)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
