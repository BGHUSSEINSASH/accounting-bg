{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "database/**,pglite.data,pglite.wasm,initdb.wasm,dist/pglite.data,dist/pglite.wasm,dist/initdb.wasm"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
