PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# ====================================================
# PostgreSQL — استبدل هذا بـ DATABASE_URL من Supabase أو Render
# ====================================================
# للحصول على هذا: https://supabase.com → Project → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ====================================================
# JWT Secrets — يجب تغييرها لقيم عشوائية طويلة
# توليد قيمة عشوائية: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ====================================================
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
REFRESH_SECRET=replace-with-a-second-long-random-secret-at-least-64-characters
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=7d

# ====================================================
# CORS — عنوان Frontend على Vercel
# ====================================================
FRONTEND_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
PUBLIC_URL=https://your-app.vercel.app

# ====================================================
# Storage
# ====================================================
UPLOAD_DIR=/app/backend/uploads
BACKUP_DIR=/app/backend/backups

# ====================================================
# Cloud Sync (Supabase Storage — اختياري)
# ====================================================
CLOUD_PROVIDER=none
# CLOUD_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=accounting-files
