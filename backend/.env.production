PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# Public URLs
APP_URL=https://your-frontend.vercel.app
PUBLIC_URL=https://your-frontend.vercel.app
FRONTEND_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
DOMAIN_NAME=your-backend.onrender.com
WWW_DOMAIN=www.your-backend.onrender.com
LETSENCRYPT_EMAIL=admin@your-domain.com

# Auth
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=7d

# Local storage paths inside the container
DB_PATH=/app/backend/data/accounting.db
UPLOAD_DIR=/app/backend/uploads
BACKUP_DIR=/app/backend/backups

# Cloud sync
CLOUD_PROVIDER=supabase
CLOUD_SYNC_INTERVAL_MS=900000

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_BUCKET=accounting-files

# S3 / Backblaze B2 (use these when CLOUD_PROVIDER=s3 or CLOUD_PROVIDER=backblaze)
S3_REGION=us-east-1
S3_BUCKET=accounting-files
S3_ENDPOINT=https://s3.us-east-001.backblazeb2.com
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://your-public-bucket-url
